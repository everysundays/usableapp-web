---
import './styles/main.css';
import Nav from './components/Nav.astro';
import Footer from './components/Footer.astro';
import type { FooterSpec, KitOptions, NavSpec } from './types';

export interface Props {
  meta: { title: string; description: string; lang: string };
  nav?: NavSpec;
  footer?: FooterSpec;
  options?: KitOptions;
}

const { meta, nav, footer, options } = Astro.props;

// Options reach initKit through data-kn-options on <body>. Astro hoists a plain
// <script> into a bundled module (so it can import ./motion), while a define:vars
// script is inlined and loses imports, so the JSON attribute is the simplest bridge.

// Only the weights a kit rule references. Space Grotesk 800 is faux-bolded from 700, as on the original.
const GOOGLE_FONTS =
  'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;700;800&family=Caveat:wght@700&family=JetBrains+Mono:wght@500;700&display=swap';
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#dffc63" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={GOOGLE_FONTS} />
    <title>{meta.title}</title>
  </head>
  <body class="kn" data-kn-options={JSON.stringify(options ?? {})}>
    {nav && <Nav {...nav} />}
    <slot />
    {footer && <Footer {...footer} />}
    <script>
      import { initKit } from './motion';
      import type { KitOptions } from './types';

      const options: KitOptions = JSON.parse(document.body.dataset.knOptions ?? '{}');
      initKit(document, options);
    </script>
  </body>
</html>
