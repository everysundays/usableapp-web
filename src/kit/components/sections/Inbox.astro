---
import type { InboxProps } from '../../types';
import Button from '../Button.astro';

export type Props = InboxProps;

const { id, kicker, heading, body = [], items = [], cta, image } = Astro.props;
---

<section data-kn-section="inbox" class="kn-inbox" {id}>
  <div class="kn-inbox__panel">
    <div class="kn-inbox__copy">
      <p class="kn-inbox__kicker kn-kicker">{kicker}</p>
      <h2 class="kn-inbox__heading">{heading}</h2>
      {body.map((text) => <p class="kn-inbox__body kn-lead">{text}</p>)}
      <Button variant="section-light" label={cta.label} href={cta.href} external={cta.external} />
    </div>
    <figure class="kn-inbox__visual">
      <img
        class="kn-inbox__img"
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading={image.loading ?? 'lazy'}
        decoding="async"
      />
    </figure>
    {items.length > 0 && (
      <ul class="kn-inbox__items">
        {items.map((item) => (
          <li class="kn-inbox__item">
            <h3 class="kn-inbox__item-title">{item.title}</h3>
            <p class="kn-inbox__item-desc">{item.desc}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
