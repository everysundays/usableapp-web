      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "challenge": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    },
    "results": {
